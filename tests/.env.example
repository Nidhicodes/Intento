# Generate fresh private keys for testing — DO NOT use real funds
# Use: node -e "console.log('0x' + require('crypto').randomBytes(32).toString('hex'))"

# Delegator (simulates user's smart account owner)
DELEGATOR_PRIVATE_KEY=0x...

# Session account (orchestrator)
ORCHESTRATOR_PRIVATE_KEY=0x...

# Sub-agent accounts
RISK_AGENT_PRIVATE_KEY=0x...
YIELD_AGENT_PRIVATE_KEY=0x...
EXECUTION_AGENT_PRIVATE_KEY=0x...

# Pimlico bundler API key (free tier works for testnet)
PIMLICO_API_KEY=...

# Venice API key (for non-x402 calls during testing)
VENICE_API_KEY=...

# RPC (Base Sepolia — public is fine for testing)
BASE_SEPOLIA_RPC=https://sepolia.base.org
