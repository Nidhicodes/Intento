# =============================================================================
# Intento — single Vercel deploy (Root Directory = frontend)
# The backend runs inside Next.js API routes (/api/*), so one deploy serves
# both the UI and the API. Copy this to .env.local for local dev.
# =============================================================================

# --- API base ---
# Leave UNSET for same-origin (recommended). The browser calls /api/* on the
# same host. Only set this if you run a separate standalone backend.
# NEXT_PUBLIC_API_URL=

# --- Server-side (API routes) — testnet-only demo keys, no real funds ---
ORCHESTRATOR_PRIVATE_KEY=0x...
RISK_AGENT_PRIVATE_KEY=0x...
YIELD_AGENT_PRIVATE_KEY=0x...
EXECUTION_AGENT_PRIVATE_KEY=0x...

# LLM provider: "groq" (free, for dev) or "venice" (paid, for the Venice track)
LLM_PROVIDER=groq
GROQ_API_KEY=
VENICE_API_KEY=

# Chain
CHAIN=base-sepolia
RPC_URL=https://sepolia.base.org

# --- Client-side (browser) ---
# Orchestrator session key — MUST match ORCHESTRATOR_PRIVATE_KEY above.
# Keeps the delegation chain consistent (frontend signs redelegations,
# backend coordinates agents). Testnet demo only.
NEXT_PUBLIC_ORCHESTRATOR_KEY=0x...
