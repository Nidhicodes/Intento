{
  "name": "intento",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Agentic DeFi portfolio management with ERC-7710/7715 redelegation, Venice AI, x402, and 1Shot",
  "scripts": {
    "dev:backend": "tsx watch src/server.ts",
    "dev:frontend": "next dev --dir frontend",
