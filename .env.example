# === Agent Private Keys (testnet only — never use keys holding real funds) ===
# Generate each: node -e "console.log('0x' + require('crypto').randomBytes(32).toString('hex'))"
ORCHESTRATOR_PRIVATE_KEY=0x...
RISK_AGENT_PRIVATE_KEY=0x...
YIELD_AGENT_PRIVATE_KEY=0x...
EXECUTION_AGENT_PRIVATE_KEY=0x...

# === LLM Provider ===
# "groq" (free, recommended for dev) or "venice" (for the Venice track)
LLM_PROVIDER=groq
GROQ_API_KEY=                 # Free, no card: https://console.groq.com/keys
VENICE_API_KEY=               # https://venice.ai (only needed when LLM_PROVIDER=venice)

# === Optional ===
PIMLICO_API_KEY=              # Free at dashboard.pimlico.io (fallback bundler)

# === Chain ===
# "base-sepolia" for free delegation + onchain redemption proof (recommended)
# "base" for Venice x402 / 1Shot (mainnet-only services)
CHAIN=base-sepolia
RPC_URL=https://sepolia.base.org

# === Server ===
PORT=3001
WEBHOOK_URL=http://localhost:3001/webhook/1shot
